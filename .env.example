# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and never committed.

# Resend email API (https://resend.com) — used by the contact form.
# Create a free account, add an API key here.
RESEND_API_KEY=

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=finance.club@example.com

# The "from" address shown on delivered emails.
# Until you verify your own domain in Resend, use onboarding@resend.dev.
CONTACT_FROM_EMAIL=onboarding@resend.dev
